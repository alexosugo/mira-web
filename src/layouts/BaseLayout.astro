---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  /** Explicit canonical path; defaults to the current URL pathname. */
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Page-specific JSON-LD merged into the site-wide @graph. */
  jsonLd?: object | object[];
  /** When true, renders noindex,follow (legal drafts until review). */
  noindex?: boolean;
  /** Mixpanel page-view label; written to <body data-page-name>. */
  pageName?: string;
}

const {
  title = 'Sellogram — answers customers and helps them order in your Instagram DMs',
  description = 'Sellogram answers product questions, helps customers choose, and puts orders together in your Instagram DMs. Built in Kenya, priced in KES. Start free.',
  canonicalPath,
  ogTitle,
  ogDescription,
  jsonLd,
  noindex = false,
  pageName,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href;

// Open Graph / Twitter fallback to the page title/description when not provided.
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;

// JSON-LD: WebSite + Product (site-wide) plus optional Organization and any
// page-specific nodes (Offer, FAQPage) passed via the jsonLd prop. Kept factual
// per docs/voice-and-tone.md (no hype).
const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://withmira.co/#website',
      url: 'https://withmira.co/',
      name: 'Sellogram',
      description,
      inLanguage: 'en',
    },
    {
      '@type': 'Product',
      '@id': 'https://withmira.co/#product',
      name: 'Sellogram',
      description:
        'Sellogram answers product questions in Instagram DMs, helps customers choose, builds carts, and sends payment instructions. The shop owner confirms payment.',
      brand: { '@type': 'Brand', name: 'Sellogram' },
      url: 'https://withmira.co/',
      areaServed: 'KE',
    },
    {
      '@type': 'Organization',
      '@id': 'https://withmira.co/#organization',
      url: 'https://withmira.co/',
      name: 'Sellogram',
      email: 'hello@sellogram.co',
    },
    ...pageNodes,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Favicon Implementation -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme colors and meta tags for mobile browsers -->
    <meta name="theme-color" content="#F2F6F3" />
    <meta name="msapplication-TileColor" content="#F2F6F3" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={resolvedOgTitle} />
    <meta property="twitter:description" content={resolvedOgDescription} />

    <!-- Additional Meta Tags -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="language" content="English" />
    <meta name="geo.region" content="KE" />
    <meta name="geo.country" content="Kenya" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://images.pexels.com" />

    <!-- Google Fonts: Archivo (display), Source Sans 3 (body/UI), IBM Plex Mono (timestamps, KES figures) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-page-name={pageName} style="font-family: 'Source Sans 3', sans-serif; background-color: #F2F6F3;">
    <slot />
    <noscript>
      <div style="max-width: 36rem; margin: 2rem auto; padding: 0 1.5rem; color: #1B2620; text-align: center;">
        <p style="font-size: 1rem; line-height: 1.6;">Some interactive details need JavaScript. To get started, open the app.</p>
        <a href="https://app.withmira.co" style="display: inline-block; margin-top: 0.75rem; padding: 0.75rem 1.5rem; border-radius: 999px; background: #1B2620; color: #F2F6F3; font-weight: 600; text-decoration: none;">Open Sellogram</a>
      </div>
    </noscript>
    <script>
      import '../lib/page-init';
    </script>
  </body>
</html>
