---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import EliteModalButton from '../components/EliteModalButton';
import PricingMatrix from '../components/PricingMatrix';
import type { PageContent, ContentSection, FaqItem } from '../content/pages';
import type { Route } from '../lib/routes';
import { jsonLdForPage } from '../lib/structured-data';

interface Props {
  /** Page body data: hero + sections (+ faq carried as a section). */
  page: PageContent;
  /** Route metadata from the registry: title, description, pageName, indexable. */
  route: Route;
  /** Page-specific JSON-LD node(s) merged into the site-wide graph. */
  jsonLd?: object | object[];
}

const { page, route, jsonLd } = Astro.props;
const pageJsonLd = [...jsonLdForPage(page), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

// Primary CTA styling mirrors the homepage header CTA (fern pill).
const ctaClass = (variant: 'primary' | 'secondary' | undefined) =>
  variant === 'secondary'
    ? 'inline-flex min-h-[44px] items-center rounded-full border border-ink/25 px-6 text-sm font-medium text-ink transition-colors duration-200 hover:border-ink hover:bg-ink/5'
    : 'inline-flex min-h-[44px] items-center rounded-full bg-fern px-6 text-sm font-medium text-paper transition-colors duration-200 hover:bg-fern-deep';

const sectionId = (index: number, kind: string) => `${kind}-${index}`;

// Insert a mid-page CTA band after this section index.
const ctaBreakPoint = Math.floor(page.sections.length / 2);

// Vary section padding by kind for visual rhythm.
const sectionPadding = (kind: string) => {
  if (kind === 'story') return 'py-24 sm:py-32';
  if (kind === 'faq') return 'py-16 sm:py-20';
  return 'py-20 sm:py-24';
};
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  pageName={route.pageName}
  noindex={!route.indexable}
  jsonLd={pageJsonLd}
>
  <div class="min-h-screen bg-paper">
    <Header client:load />
    <main>
      {/* Hero */}
      <section>
        <div class="mx-auto max-w-6xl px-6 pb-20 pt-32 sm:pt-40 lg:px-8">
          <h1 class="max-w-2xl font-display text-[clamp(2.25rem,1.4rem+4vw,4rem)] font-medium leading-[1.05] tracking-tight text-ink [text-wrap:balance]">
            {page.hero.h1}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-light">{page.hero.intro}</p>
          {(page.hero.primaryCta || page.hero.secondaryLink) && (
            <div class="mt-10 flex flex-wrap items-center gap-4">
              {page.hero.primaryCta && (
                <a href={page.hero.primaryCta.href} class={ctaClass(page.hero.primaryCta.variant)}>
                  {page.hero.primaryCta.label}
                </a>
              )}
              {page.hero.secondaryLink && (
                page.hero.secondaryLink.href === 'modal:elite' ? (
                  <EliteModalButton client:load label={page.hero.secondaryLink.label} location={`${route.pageName} hero`} />
                ) : (
                  <a
                    href={page.hero.secondaryLink.href}
                    class="text-sm font-medium text-ink underline-offset-4 transition-colors hover:text-ink-light hover:underline"
                  >
                    {page.hero.secondaryLink.label}
                  </a>
                )
              )}
            </div>
          )}
        </div>
      </section>

      {/* Body sections */}
      {page.sections.map((section: ContentSection, index: number) => (
        <Fragment>
          {/* Mid-page CTA band */}
          {index === ctaBreakPoint && (
            <section class="bg-fern/5">
              <div class="mx-auto max-w-2xl px-6 py-12 text-center lg:px-8">
                <p class="text-lg text-ink">Ready to stop typing the same replies?</p>
                <a
                  href="https://app.withmira.co"
                  class="mt-6 inline-flex min-h-[44px] items-center rounded-full bg-fern px-6 text-sm font-medium text-paper transition-colors duration-200 hover:bg-fern-deep"
                >
                  Start free
                </a>
              </div>
            </section>
          )}

          <section
            id={sectionId(index, section.kind)}
            class={index % 2 === 1 ? 'bg-paper-raised' : ''}
          >
            <div class={`mx-auto max-w-6xl px-6 lg:px-8 ${sectionPadding(section.kind)}`}>
              {section.kind === 'prose' && (
                <div class="max-w-2xl">
                  {section.heading && (
                    <h2 class="font-display text-[clamp(1.75rem,1.2rem+2.4vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-ink">
                      {section.heading}
                    </h2>
                  )}
                  <p class="mt-6 text-lg leading-relaxed text-ink-light">{section.body}</p>
                </div>
              )}

              {section.kind === 'split' && (
                <div class="grid gap-12 md:grid-cols-2 md:gap-16">
                  <div>
                    <h2 class="font-display text-[clamp(1.75rem,1.2rem+2.4vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-ink">
                      {section.heading}
                    </h2>
                  </div>
                  <p class="self-start text-lg leading-relaxed text-ink-light md:pt-2">{section.body}</p>
                </div>
              )}

              {section.kind === 'list' && (
                <div>
                  {section.heading && (
                    <h2 class="max-w-xl font-display text-[clamp(1.75rem,1.2rem+2.4vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-ink">
                      {section.heading}
                    </h2>
                  )}
                  <ul class="mt-10 space-y-5">
                    {section.items.map((item: string) => (
                      <li class="flex items-baseline gap-4">
                        <span class="text-ink-faint">—</span>
                        <span class="text-base leading-relaxed text-ink">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {section.kind === 'numbered' && (
                <div>
                  {section.heading && (
                    <h2 class="max-w-xl font-display text-[clamp(1.75rem,1.2rem+2.4vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-ink">
                      {section.heading}
                    </h2>
                  )}
                  <ol class="mt-12 grid gap-6 sm:grid-cols-2 sm:gap-8">
                    {section.items.map((item) => (
                      <li class="rounded-2xl bg-white p-6">
                        <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                        <p class="mt-2 text-base leading-relaxed text-ink-light">{item.body}</p>
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {section.kind === 'story' && (
                <div>
                  <h2 class="max-w-2xl font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink [text-wrap:balance]">
                    {section.heading}
                  </h2>
                  <div class="mt-6 grid gap-12 md:grid-cols-2 md:gap-16">
                    <p class="text-lg leading-relaxed text-ink-light">{section.body}</p>
                    <p class="text-base leading-relaxed text-ink-faint">{section.aside}</p>
                  </div>
                </div>
              )}

              {section.kind === 'fitGuide' && (
                <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
                  <div class="lg:col-span-5">
                    <h2 class="font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink [text-wrap:balance]">
                      {section.heading}
                    </h2>
                    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-light">{section.body}</p>
                  </div>
                  <div class="space-y-4 lg:col-span-6 lg:col-start-7">
                    <div class="rounded-2xl bg-white p-5">
                      <p class="text-sm text-ink-faint">Works best when</p>
                      <p class="mt-2 text-base leading-relaxed text-ink">{section.worksBest}</p>
                    </div>
                    <div class="rounded-2xl bg-white p-5">
                      <p class="text-sm text-ink-faint">Mira hands over when</p>
                      <p class="mt-2 text-base leading-relaxed text-ink">{section.handoff}</p>
                    </div>
                    <div class="rounded-2xl bg-fern/5 p-5 ring-1 ring-fern/20">
                      <p class="text-sm text-fern-deep">What you get</p>
                      <p class="mt-2 text-base leading-relaxed text-ink">{section.ownerGets}</p>
                    </div>
                  </div>
                </div>
              )}

              {section.kind === 'promiseGrid' && (
                <div>
                  <h2 class="max-w-2xl font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink [text-wrap:balance]">
                    {section.heading}
                  </h2>
                  <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-x-8 md:gap-y-8">
                    {section.items.map((item) => (
                      <article class="rounded-2xl bg-white p-6">
                        <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                        <p class="mt-2 text-base leading-relaxed text-ink-light">{item.body}</p>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {section.kind === 'beforeAfter' && (
                <div>
                  <h2 class="max-w-2xl font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink [text-wrap:balance]">
                    {section.heading}
                  </h2>
                  <div data-before-after class="mt-12">
                    <div class="sticky top-24" data-ba-before-wrapper>
                      <div data-ba-before class="mx-auto max-w-2xl rounded-3xl bg-white p-8">
                        <ul class="space-y-5">
                          {section.content.before.map((item) => (
                            <li class="flex items-start gap-3">
                              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-faint/40"></span>
                              <span class="text-base leading-relaxed text-ink-faint">{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                    <div data-ba-spacer></div>
                    <div class="sticky top-24" data-ba-after-wrapper>
                      <div data-ba-after class="mx-auto max-w-2xl rounded-3xl bg-night p-8 ring-1 ring-fern/30">
                        <ul class="space-y-5">
                          {section.content.after.map((item) => (
                            <li class="flex items-start gap-3">
                              <svg class="mt-0.5 h-4 w-4 shrink-0 text-fern-bright" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                              <span class="text-base leading-relaxed text-paper">{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                    <div data-ba-spacer-end></div>
                  </div>
                </div>
              )}

              {section.kind === 'scenarios' && (
                <div>
                  <h2 class="max-w-2xl font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink [text-wrap:balance]">
                    {section.heading}
                  </h2>
                  <div class="mt-12 mx-auto max-w-xl space-y-8">
                    {section.items.map((item) => (
                      <div class="space-y-2" data-scenario>
                        <div class="flex justify-start scenario-bubble scenario-customer">
                          <p class="max-w-[80%] rounded-2xl rounded-bl-md border border-line bg-white px-4 py-2.5 text-sm leading-relaxed text-ink">
                            {item.customer}
                          </p>
                        </div>
                        <div class="flex justify-end scenario-bubble scenario-mira">
                          <p class="max-w-[80%] rounded-2xl rounded-br-md bg-fern px-4 py-2.5 text-sm leading-relaxed text-paper">
                            {item.mira}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {section.kind === 'archetype' && (
                <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
                  <div class="lg:col-span-4">
                    <h2 class="font-display text-[clamp(1.8rem,1.15rem+2.8vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink">
                      {section.name}
                    </h2>
                    <p class="mt-4 text-sm text-ink-faint">{section.role}</p>
                  </div>
                  <div class="lg:col-span-7 lg:col-start-6">
                    <div class="grid gap-8 md:grid-cols-2">
                      <div>
                        <h3 class="text-base font-semibold text-ink">A normal day</h3>
                        <ul class="mt-5 space-y-4">
                          {section.day.map((item) => (
                            <li class="text-base leading-relaxed text-ink-light">{item}</li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        <h3 class="text-base font-semibold text-fern-deep">Where Mira fits</h3>
                        <ul class="mt-5 space-y-4">
                          {section.miraHelps.map((item) => (
                            <li class="text-base leading-relaxed text-ink-light">{item}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {section.kind === 'legal' && (
                <article class="max-w-3xl">
                  <h2 class="font-display text-[clamp(1.5rem,1.05rem+2vw,2.25rem)] font-medium leading-[1.12] tracking-tight text-ink">
                    {section.heading}
                  </h2>
                  <div class="mt-6 space-y-4">
                    {section.paragraphs.map((paragraph) => (
                      <p class="text-base leading-relaxed text-ink-light">{paragraph}</p>
                    ))}
                  </div>
                </article>
              )}

              {section.kind === 'pricingMatrix' && <PricingMatrix client:load />}

              {section.kind === 'faq' && (
                <div class="max-w-2xl">
                  <h2 class="font-display text-[clamp(1.75rem,1.2rem+2.4vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-ink">
                    Questions
                  </h2>
                  <dl class="mt-10 space-y-6">
                    {section.items.map((item: FaqItem) => (
                      <div>
                        <dt class="text-base font-semibold text-ink">{item.question}</dt>
                        <dd class="mt-2 text-base leading-relaxed text-ink-light">{item.answer}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </div>
          </section>
          <!--
          {section.kind === 'scenarios' && (
            <section class="bg-fern/[0.06]">
              <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28 lg:px-8">
                <h2 class="max-w-2xl font-display text-[clamp(2rem,1.3rem+3.5vw,3.5rem)] font-medium leading-[1.05] tracking-tight text-ink [text-wrap:balance]">
                  Stop typing. Start selling.
                </h2>
                <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-light">
                  Mira answers your DMs from your shop's details. Free to start.
                </p>
                {page.hero.primaryCta && (
                  <a
                    href={page.hero.primaryCta.href}
                    class="mt-10 inline-flex min-h-[48px] items-center rounded-full bg-fern px-7 text-base font-medium text-paper transition-colors duration-200 hover:bg-fern-deep"
                  >
                    {page.hero.primaryCta.label}
                  </a>
                )}
                <p class="mt-6 max-w-xl text-sm text-ink-faint">
                  No card needed · Cancel anytime · Works with your Instagram
                </p>
              </div>
            </section>
          )}
          -->
        </Fragment>
      ))}
    </main>
    <Footer client:visible />
  </div>

  <script>
    document.documentElement.classList.add('js');

    const scenarios = document.querySelectorAll('[data-scenario]');

    if (scenarios.length > 0) {
      const updateBubbles = () => {
        const vh = window.innerHeight;

        scenarios.forEach((group) => {
          const top = group.getBoundingClientRect().top;

          // Map scroll position to a 0–1 progress value.
          // 0 = group just entering from the bottom; 1 = group well into view.
          const enterY = vh * 0.85;
          const revealY = vh * 0.35;
          const progress = Math.max(0, Math.min(1, (enterY - top) / (enterY - revealY)));

          const bubbles = group.querySelectorAll('.scenario-bubble');
          bubbles.forEach((bubble, i) => {
            // Stagger: customer (i=0) reveals first, mira (i=1) follows.
            const start = i * 0.25;
            const span = 0.5;
            const raw = Math.max(0, Math.min(1, (progress - start) / span));
            // smoothstep easing for a gentle curve.
            const eased = raw * raw * (3 - 2 * raw);
            bubble.style.opacity = eased;
            bubble.style.transform = `translateY(${(1 - eased) * 14}px)`;
          });
        });
      };

      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateBubbles();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateBubbles();
    }

    // Before/After sticky stack — fade the before card as the after card covers it.
    // The covering itself is pure CSS (sticky positioning). JS only handles opacity.
    const baSections = document.querySelectorAll('[data-before-after]');

    if (baSections.length > 0) {
      const updateBeforeAfter = () => {
        baSections.forEach((section) => {
          const afterWrapper = section.querySelector('[data-ba-after-wrapper]');
          const beforeCard = section.querySelector('[data-ba-before]');
          if (!afterWrapper || !beforeCard) return;

          const beforeRect = beforeCard.getBoundingClientRect();
          const afterRect = afterWrapper.getBoundingClientRect();
          const stickyTop = 96; // 6rem (top-24)

          // Fade starts when the after card's top edge reaches the before
          // card's bottom edge — i.e. when covering actually begins.
          // Finishes when the after card reaches the sticky position.
          const fadeStart = beforeRect.bottom;
          const fadeEnd = stickyTop;
          const raw = Math.max(0, Math.min(1,
            (fadeStart - afterRect.top) / (fadeStart - fadeEnd),
          ));
          const eased = raw * raw * (3 - 2 * raw);

          beforeCard.style.opacity = String(1 - eased);
        });
      };

      let baTicking = false;
      const onBAScroll = () => {
        if (!baTicking) {
          requestAnimationFrame(() => {
            updateBeforeAfter();
            baTicking = false;
          });
          baTicking = true;
        }
      };

      window.addEventListener('scroll', onBAScroll, { passive: true });
      window.addEventListener('resize', onBAScroll, { passive: true });
      updateBeforeAfter();
    }
  </script>
</BaseLayout>
