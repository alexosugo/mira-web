---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import PricingMatrix from '../components/PricingMatrix';
import ContentHero from '../components/content/ContentHero.astro';
import ShopUseCasePage from '../components/content/ShopUseCasePage.astro';
import DmThread from '../components/content/DmThread.astro';
import Timeline from '../components/content/Timeline.astro';
import PairedLedger from '../components/content/PairedLedger.astro';
import Faq from '../components/content/Faq.astro';
import EliteModalButton from '../components/EliteModalButton';
import type { PageContent, ContentSection, FaqItem } from '../content/pages';
import type { Route } from '../lib/routes';
import { jsonLdForPage } from '../lib/structured-data';
import { variantForPath, decorForPath, heroPhotoForPath } from '../lib/page-variant';

interface Props {
  /** Page body data: hero + sections (+ faq carried as a section). */
  page: PageContent;
  /** Route metadata from the registry: title, description, pageName, indexable. */
  route: Route;
  /** Page-specific JSON-LD node(s) merged into the site-wide graph. */
  jsonLd?: object | object[];
}

const { page, route, jsonLd } = Astro.props;
const pageJsonLd = [...jsonLdForPage(page), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

const variant = variantForPath(page.path);
const decor = decorForPath(page.path);
const heroPhoto = heroPhotoForPath(page.path);
const withThree = page.path === '/instagram-dm-automation';

// Legal pages read as one document: narrow measure, § numbering, and a sticky
// table of contents once there are enough sections to warrant one.
const isDocument = variant === 'legal';
const tocEntries = isDocument
  ? page.sections
      .map((section, index) => ({
        id: `${section.kind}-${index}`,
        label: 'heading' in section && section.heading ? section.heading : null,
      }))
      .filter((entry): entry is { id: string; label: string } => entry.label !== null)
  : [];
const showToc = tocEntries.length >= 3;

// Mid-page CTA band — product pages only; never inside legal/trust documents.
const showCtaBand = variant === 'guide' || variant === 'feature' || variant === 'useCase' || variant === 'company';
const ctaBreakPoint = Math.floor(page.sections.length / 2);

// Vary section padding by kind for visual rhythm.
const sectionPadding = (kind: string) => {
  if (kind === 'story') return 'py-24 sm:py-32';
  if (kind === 'faq') return 'py-16 sm:py-20';
  if (kind === 'legal') return 'py-10 sm:py-12';
  return 'py-20 sm:py-24';
};

const sectionId = (index: number, kind: string) => `${kind}-${index}`;

const isPanel = (index: number) => index % 2 === 0;
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  pageName={route.pageName}
  noindex={!route.indexable}
  jsonLd={pageJsonLd}
>
  <div class="min-h-screen bg-paper">
    <Header client:load />
    <main id="main-content" tabindex="-1">
      {page.shopStory ? (
        <ShopUseCasePage hero={page.hero} story={page.shopStory} route={route} />
      ) : (
        <ContentHero hero={page.hero} route={route} variant={variant} decor={decor} photo={heroPhoto} withThree={withThree} />
      )}

      {!page.shopStory && (isDocument ? (
        <div class="mx-auto max-w-[1280px] px-5 pb-24 sm:px-8 lg:px-10">
          <div class={showToc ? 'lg:grid lg:grid-cols-12 lg:gap-16' : ''}>
            {showToc && (
              <nav class="mb-12 lg:col-span-4 lg:mb-0 xl:col-span-3" aria-label="On this page">
                <div class="lg:sticky lg:top-28">
                  <p class="kicker text-ink-faint">On this page</p>
                  <ol class="mt-5 border-l border-line lg:space-y-3">
                    {tocEntries.map((entry) => (
                      <li>
                        <a
                          href={`#${entry.id}`}
                          class="-ml-px flex min-h-[44px] items-center border-l-2 border-transparent pl-4 text-sm text-ink-light transition-colors hover:border-fern hover:text-ink lg:min-h-0"
                        >
                          {entry.label}
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              </nav>
            )}
            <div class={showToc ? 'lg:col-span-8 xl:col-span-8' : 'max-w-3xl'}>
              {page.sections.map((section, index) => (
                <section id={sectionId(index, section.kind)} class="scroll-mt-28 border-t border-line py-10 first:border-t-0 first:pt-0 sm:py-12">
                  {section.kind === 'legal' && (
                    <article class="max-w-3xl">
                      <h2 class="font-display text-[clamp(1.4rem,1.05rem+1.6vw,2rem)] font-semibold leading-[1.15] tracking-tight text-ink [text-wrap:balance]">
                        {section.heading}
                      </h2>
                      <div class="mt-5 space-y-4">
                        {section.paragraphs.map((paragraph) => (
                          <p class="text-base leading-relaxed text-ink-light">{paragraph}</p>
                        ))}
                      </div>
                    </article>
                  )}
                  {section.kind === 'prose' && (
                    <div class="max-w-3xl">
                      {section.heading && (
                        <h2 class="font-display text-[clamp(1.4rem,1.05rem+1.6vw,2rem)] font-semibold leading-[1.15] tracking-tight text-ink [text-wrap:balance]">
                          {section.heading}
                        </h2>
                      )}
                      <p class={`text-base leading-relaxed text-ink-light ${section.heading ? 'mt-5' : ''}`}>{section.body}</p>
                    </div>
                  )}
                  {section.kind === 'list' && (
                    <div class="max-w-3xl">
                      {section.heading && (
                        <h2 class="font-display text-[clamp(1.4rem,1.05rem+1.6vw,2rem)] font-semibold leading-[1.15] tracking-tight text-ink [text-wrap:balance]">
                          {section.heading}
                        </h2>
                      )}
                      <ul class="mt-6 space-y-3 rounded-2xl border border-line bg-white p-6">
                        {section.items.map((item) => (
                          <li class="flex items-baseline gap-3">
                            <span class="font-body text-xs text-fern-deep" aria-hidden="true">→</span>
                            <span class="text-base leading-relaxed text-ink">{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {section.kind === 'faq' && <Faq items={section.items as FaqItem[]} />}
                </section>
              ))}
            </div>
          </div>
        </div>
      ) : (
        page.sections.map((section: ContentSection, index: number) => (
          <Fragment>
            {showCtaBand && index === ctaBreakPoint && (
              <section class="px-3 py-2 sm:px-6 lg:px-10">
                <div class="mx-auto flex max-w-[1440px] flex-col items-start gap-8 rounded-2xl bg-cobalt px-8 py-12 text-white sm:px-12 lg:flex-row lg:items-center lg:justify-between lg:px-16 lg:py-14">
                  <p class="max-w-2xl font-display text-[clamp(1.75rem,1.2rem+2.2vw,3rem)] font-semibold leading-[1.02] tracking-tight [text-wrap:balance]">Ready to stop typing the same replies?</p>
                  <div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-3">
                    <a
                      href="https://app.sellogram.co"
                      class="inline-flex min-h-12 items-center rounded-full bg-fern px-8 text-base font-semibold text-ink transition duration-300 hover:-translate-y-0.5 hover:bg-white active:translate-y-0 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:hover:translate-y-0"
                    >
                      Start free
                    </a>
                    <p class="font-body text-sm text-white/80">No card needed</p>
                  </div>
                </div>
              </section>
            )}

            <section id={sectionId(index, section.kind)} class={`scroll-mt-28 ${isPanel(index) ? 'px-3 py-2 sm:px-6 lg:px-10' : ''}`}>
              <div class={isPanel(index) ? 'mx-auto max-w-[1440px] rounded-2xl bg-paper-raised' : ''}>
                <div class={`mx-auto max-w-[1280px] ${isPanel(index) ? 'px-5 sm:px-10 lg:px-14' : 'px-5 sm:px-8 lg:px-10'} ${sectionPadding(section.kind)}`}>
                  {section.kind === 'prose' && (
                    <div class="max-w-2xl">
                      {section.heading && (
                        <h2 class="heading-section-compact">
                          {section.heading}
                        </h2>
                      )}
                      <p class={section.heading ? 'mt-6 text-lg leading-relaxed text-ink-light' : 'font-display text-2xl leading-snug text-ink [text-wrap:balance] sm:text-3xl'}>{section.body}</p>
                    </div>
                  )}

                  {section.kind === 'split' && (
                    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
                      <div>
                        <h2 class="heading-section-compact">
                          {section.heading}
                        </h2>
                      </div>
                      <p class="self-start text-lg leading-relaxed text-ink-light md:pt-2">{section.body}</p>
                    </div>
                  )}

                  {section.kind === 'list' && (
                    <div>
                      {section.heading && (
                        <h2 class="max-w-xl heading-section-compact">
                          {section.heading}
                        </h2>
                      )}
                      <ul class="mt-10 space-y-5">
                        {section.items.map((item: string) => (
                          <li class="flex items-baseline gap-4">
                            <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-fern-deep" aria-hidden="true"></span>
                            <span class="text-base leading-relaxed text-ink">{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {section.kind === 'numbered' && (
                    <Timeline heading={section.heading} items={section.items} />
                  )}

                  {section.kind === 'story' && (
                    <div class={section.aside ? 'grid gap-10 lg:grid-cols-12 lg:gap-16' : ''}>
                      <div class={section.aside ? 'lg:col-span-7' : 'max-w-3xl'}>
                        <h2 class="heading-section">
                          {section.heading}
                        </h2>
                        <p class={`mt-6 leading-relaxed text-ink-light ${variant === 'company' ? 'font-display text-xl sm:text-2xl' : 'text-lg'}`}>
                          {section.body}
                        </p>
                      </div>
                      {section.aside && (
                        <aside class="lg:col-span-4 lg:col-start-9 lg:self-center">
                          <div class="relative rounded-2xl bg-white p-7 shadow-[0_24px_60px_rgba(19,30,9,0.14)] sm:p-8 lg:rotate-2">
                            <span class="absolute -top-3 left-7 h-6 w-14 -rotate-3 rounded-sm bg-fern/80" aria-hidden="true"></span>
                            <p class="font-display text-xl leading-snug text-ink [text-wrap:pretty]">{section.aside}</p>
                          </div>
                        </aside>
                      )}
                    </div>
                  )}

                  {section.kind === 'fitGuide' && (
                    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
                      <div class="lg:col-span-5">
                        <h2 class="heading-section">
                          {section.heading}
                        </h2>
                        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-light">{section.body}</p>
                      </div>
                      <div class="lg:col-span-6 lg:col-start-7">
                        <div class="overflow-hidden rounded-2xl bg-white shadow-[0_24px_60px_rgba(19,30,9,0.12)]">
                          <div class="border-b border-line px-6 py-5 sm:px-7">
                            <p class="kicker text-fern-deep">✓ Works best when</p>
                            <p class="mt-3 text-base leading-relaxed text-ink">{section.worksBest}</p>
                          </div>
                          <div class="border-b border-line px-6 py-5 sm:px-7">
                            <p class="kicker text-dawn-deep">↗ Sellogram hands over when</p>
                            <p class="mt-3 text-base leading-relaxed text-ink">{section.handoff}</p>
                          </div>
                          <div class="bg-night px-6 py-5 sm:px-7">
                            <p class="kicker text-ink">● What you get</p>
                            <p class="mt-3 text-base leading-relaxed text-ink">{section.ownerGets}</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}

                  {section.kind === 'promiseGrid' && variant === 'support' && (
                    <div>
                      <h2 class="max-w-2xl heading-section">
                        {section.heading}
                      </h2>
                      <div class="mt-12 grid gap-5 sm:grid-cols-2">
                        {section.items.map((item) => (
                          <article class="rounded-2xl bg-white p-7 shadow-[0_1px_0_rgba(19,30,9,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_rgba(19,30,9,0.12)] motion-reduce:hover:translate-y-0 sm:p-8">
                            <h3 class="font-display text-xl font-semibold text-ink">{item.title}</h3>
                            <p class="mt-3 text-base leading-relaxed text-ink-light">{item.body}</p>
                            {item.cta &&
                              (item.cta.href === 'modal:elite' ? (
                                <EliteModalButton
                                  client:load
                                  label={item.cta.label}
                                  location={`${route.pageName} ${section.heading}`}
                                  className="mt-4 inline-flex min-h-[44px] items-center text-sm font-medium text-fern-deep underline-offset-4 hover:underline"
                                />
                              ) : (
                                <a
                                  href={item.cta.href}
                                  class="mt-4 inline-flex min-h-[44px] items-center text-sm font-medium text-fern-deep underline-offset-4 hover:underline"
                                >
                                  {item.cta.label}
                                </a>
                              ))}
                          </article>
                        ))}
                      </div>
                    </div>
                  )}

                  {section.kind === 'promiseGrid' && variant !== 'support' && (
                    <div>
                      <h2 class="max-w-2xl heading-section">
                        {section.heading}
                      </h2>
                      <div class="mt-12 grid gap-5 md:grid-cols-2 md:gap-6 md:pb-10">
                        {section.items.map((item, itemIndex) => (
                          <article class={`rounded-2xl p-7 sm:p-8 ${isPanel(index) ? 'bg-white' : 'bg-paper-raised'} ${itemIndex % 2 === 1 ? 'md:translate-y-10' : ''}`}>
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-fern text-ink" aria-hidden="true">
                              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                            </span>
                            <h3 class="mt-5 font-display text-xl font-semibold text-ink sm:text-2xl">{item.title}</h3>
                            <p class="mt-3 text-base leading-relaxed text-ink-light [text-wrap:pretty]">{item.body}</p>
                          </article>
                        ))}
                      </div>
                    </div>
                  )}

                  {section.kind === 'beforeAfter' && (
                    <div>
                      <h2 class="max-w-2xl heading-section">
                        {section.heading}
                      </h2>
                      <div data-before-after class="mt-12 grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-0">
                        <div data-ba-card class="rounded-2xl bg-white p-8 sm:p-10 lg:[rotate:-1deg]">
                          <p class="kicker mb-6 text-ink-faint">Before Sellogram</p>
                          <ul class="space-y-5">
                            {section.content.before.map((item) => (
                              <li class="flex items-start gap-3">
                                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-faint/40"></span>
                                <span class="text-base leading-relaxed text-ink-faint">{item}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div data-ba-card class="relative z-10 rounded-2xl bg-night p-8 shadow-[0_30px_80px_rgba(68,120,12,0.28)] sm:p-10 lg:-ml-10 lg:mt-14 lg:[rotate:1deg]">
                          <p class="kicker mb-6 text-fern-bright">After Sellogram</p>
                          <ul class="space-y-5">
                            {section.content.after.map((item) => (
                              <li class="flex items-start gap-3">
                                <svg class="mt-0.5 h-4 w-4 shrink-0 text-fern-bright" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                                <span class="text-base leading-relaxed text-ink">{item}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  )}

                  {section.kind === 'scenarios' && (
                    <DmThread heading={section.heading} items={section.items} />
                  )}

                  {section.kind === 'archetype' && (
                    <PairedLedger name={section.name} role={section.role} day={section.day} sellogramHelps={section.sellogramHelps} />
                  )}

                  {section.kind === 'legal' && (
                    <article class="max-w-3xl">
                      <h2 class="font-display text-[clamp(1.5rem,1.05rem+2vw,2.25rem)] font-semibold leading-[1.12] tracking-tight text-ink [text-wrap:balance]">
                        {section.heading}
                      </h2>
                      <div class="mt-6 space-y-4">
                        {section.paragraphs.map((paragraph) => (
                          <p class="text-base leading-relaxed text-ink-light">{paragraph}</p>
                        ))}
                      </div>
                    </article>
                  )}

                  {section.kind === 'pricingMatrix' && <PricingMatrix client:load />}

                  {section.kind === 'faq' && <Faq items={section.items as FaqItem[]} />}
                </div>
              </div>
            </section>
          </Fragment>
        ))
      ))}
    </main>
    <Footer client:visible />
  </div>

  <script>
    document.documentElement.classList.add('js');

    const scenarios = document.querySelectorAll('[data-scenario]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (scenarios.length > 0) {
      const updateBubbles = () => {
        if (reducedMotion.matches) return;
        const vh = window.innerHeight;

        scenarios.forEach((group) => {
          const top = group.getBoundingClientRect().top;

          // Map scroll position to a 0–1 progress value.
          // 0 = group just entering from the bottom; 1 = group well into view.
          const enterY = vh * 0.85;
          const revealY = vh * 0.35;
          const progress = Math.max(0, Math.min(1, (enterY - top) / (enterY - revealY)));

          const bubbles = group.querySelectorAll('.scenario-bubble');
          bubbles.forEach((bubble, i) => {
            // Stagger: customer (i=0) reveals first, sellogram (i=1) follows.
            const start = i * 0.25;
            const span = 0.5;
            const raw = Math.max(0, Math.min(1, (progress - start) / span));
            // smoothstep easing for a gentle curve.
            const eased = raw * raw * (3 - 2 * raw);
            bubble.style.opacity = eased;
            bubble.style.transform = `translateY(${(1 - eased) * 14}px)`;
          });
        });
      };

      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateBubbles();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      reducedMotion.addEventListener('change', updateBubbles);
      updateBubbles();
    }

    // Before/After cards rise in with a slight stagger as they scroll into view.
    const baCards = document.querySelectorAll('[data-ba-card]');

    if (baCards.length > 0) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('animate-fade-in-up');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.2 },
      );

      baCards.forEach((card, i) => {
        // Cards come in before/after pairs; delay the second of each pair.
        (card as HTMLElement).style.animationDelay = `${(i % 2) * 150}ms`;
        io.observe(card);
      });
    }
  </script>
</BaseLayout>
