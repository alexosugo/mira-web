---
/**
 * Archetype section as a paired ledger: the seller's day on the left, where
 * Sellogram fits on the right, row by row. The parallel structure is the story —
 * every pain line meets its answer across the rule.
 */
interface Props {
  name: string;
  role: string;
  day: string[];
  sellogramHelps: string[];
}

const { name, role, day, sellogramHelps } = Astro.props;
const rows = Math.max(day.length, sellogramHelps.length);
---

<div>
  <div class="max-w-2xl">
    <h2 class="font-display text-[clamp(2.25rem,1.4rem+3.2vw,4rem)] font-semibold italic leading-[0.98] tracking-tight text-ink [text-wrap:balance]">
      {name}
    </h2>
    <p class="mt-3 font-body text-sm leading-relaxed text-ink-faint">
      {role} An example seller, not a customer story.
    </p>
  </div>

  <div class="mt-12 hidden grid-cols-2 pb-3 md:grid">
    <h3 class="kicker px-7 text-ink-faint">The day now</h3>
    <h3 class="kicker px-7 text-fern-deep">Where Sellogram fits</h3>
  </div>

  <div class="mt-6 space-y-3 md:mt-0">
    {Array.from({ length: rows }, (_, i) => (
      <div class="grid overflow-hidden rounded-2xl bg-white md:grid-cols-2">
        {day[i] && (
          <div class="flex flex-wrap items-start gap-x-3 gap-y-2 px-6 py-5 md:flex-nowrap md:gap-y-0 md:px-7">
            <span class="kicker basis-full text-ink-faint md:hidden">Now</span>
            <span class="mt-2.5 hidden h-1.5 w-1.5 shrink-0 rounded-full border border-ink-faint/50 md:block" aria-hidden="true"></span>
            <p class="min-w-0 flex-1 text-base leading-relaxed text-ink-light">{day[i]}</p>
          </div>
        )}
        {sellogramHelps[i] && (
          <div class="flex flex-wrap items-start gap-x-3 gap-y-2 bg-night px-6 py-5 md:flex-nowrap md:gap-y-0 md:px-7">
            <span class="kicker basis-full text-ink md:hidden">With Sellogram</span>
            <svg class="mt-1 h-4 w-4 shrink-0 text-fern-bright" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
            </svg>
            <p class="min-w-0 flex-1 text-base leading-relaxed text-ink">{sellogramHelps[i]}</p>
          </div>
        )}
      </div>
    ))}
  </div>
</div>
