---
/**
 * Steps as a connected checklist: tick rings joined by a rail, the last step
 * filled, revealed item-by-item on scroll (IntersectionObserver adds .is-seen;
 * without JS everything is visible).
 */
import type { ListItem } from '../../content/pages';

interface Props {
  heading?: string;
  items: ListItem[];
}

const { heading, items } = Astro.props;
---

<div>
  {heading && (
    <h2 class="max-w-xl heading-section-compact">
      {heading}
    </h2>
  )}
  <ol class="relative mt-12 max-w-3xl">
    <span class="absolute bottom-8 left-5 top-6 w-0.5 rounded-full bg-fern-deep/25" aria-hidden="true"></span>
    {items.map((item, index) => (
      <li class="timeline-step relative grid grid-cols-[2.5rem_1fr] gap-5 pb-10 last:pb-0 sm:gap-7" data-timeline-step>
        <span
          class={`relative z-10 flex h-10 w-10 items-center justify-center rounded-full transition-colors duration-500 ${
            index === items.length - 1
              ? 'bg-fern text-ink'
              : 'border-2 border-ink-faint/40 bg-paper-raised text-ink-faint/60 [.is-seen_&]:border-fern-deep [.is-seen_&]:text-fern-deep'
          }`}
          aria-hidden="true"
        >
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
        </span>
        <div class="pt-1.5">
          <h3 class="font-display text-xl font-semibold text-ink sm:text-2xl">{item.title}</h3>
          <p class="mt-2 max-w-xl text-base leading-relaxed text-ink-light [text-wrap:pretty]">{item.body}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  const steps = document.querySelectorAll('[data-timeline-step]');
  if (steps.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-seen');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -20% 0px' },
    );
    steps.forEach((step) => io.observe(step));
  } else {
    steps.forEach((step) => step.classList.add('is-seen'));
  }
</script>
