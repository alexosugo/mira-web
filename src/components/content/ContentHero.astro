---
/**
 * Variant-aware hero. Each page family opens differently — process pages get
 * ambient motion, feature pages get a floating DM texture, use-case pages get
 * their vertical's motif and a ghosted display word, legal pages get a
 * document masthead — while sharing the same type system and CTA row.
 */
import EliteModalButton from '../EliteModalButton';
import AmbientField from './AmbientField.astro';
import Motif from './Motif.astro';
import ThreadScene from './ThreadScene.astro';
import type { PageHero } from '../../content/pages';
import type { Route } from '../../lib/routes';
import type { PageVariant, UseCaseDecor } from '../../lib/page-variant';

interface Props {
  hero: PageHero;
  route: Route;
  variant: PageVariant;
  decor?: UseCaseDecor;
  /** Pillar page only: swap the 2D ambient field for the Three.js stream. */
  withThree?: boolean;
}

const { hero, route, variant, decor, withThree = false } = Astro.props;

const ctaClass = (v: 'primary' | 'secondary' | undefined) =>
  v === 'secondary'
    ? 'inline-flex min-h-[44px] items-center rounded-full border border-ink/25 px-6 text-sm font-medium text-ink transition-colors duration-200 hover:border-ink hover:bg-ink/5'
    : 'inline-flex min-h-[44px] items-center rounded-full bg-fern px-6 text-sm font-medium text-paper transition-colors duration-200 hover:bg-fern-deep';

const isDocument = variant === 'legal' || variant === 'trust';
const hasAmbient = variant === 'guide' || variant === 'feature' || variant === 'useCase';

---

<section class="relative overflow-hidden">
  {withThree ? <ThreadScene /> : hasAmbient && <AmbientField density={variant === 'guide' ? 1.4 : 0.9} />}

  {decor && (
    <span
      class="pointer-events-none absolute -bottom-8 right-0 select-none font-display text-[clamp(7rem,22vw,17rem)] font-semibold italic leading-none text-fern/[0.07]"
      aria-hidden="true"
    >
      {decor.ghostWord}
    </span>
  )}

  <div
    class={`relative mx-auto max-w-6xl px-6 lg:px-8 ${
      isDocument ? 'pb-12 pt-28 sm:pt-32' : variant === 'support' ? 'pb-14 pt-28 sm:pt-36' : 'pb-20 pt-32 sm:pt-40'
    }`}
  >
    <div class={variant === 'feature' ? 'grid items-center gap-12 lg:grid-cols-12' : ''}>
      <div class={variant === 'feature' ? 'lg:col-span-7' : ''}>
        {decor && !isDocument && (
          <p class="animate-fade-in-up mb-5">
            <Motif motif={decor.motif} class="h-9 w-9 text-fern" />
          </p>
        )}

        <h1
          class={`animate-fade-in-up font-display font-semibold tracking-tight text-ink [text-wrap:balance] [animation-delay:80ms] ${
            variant === 'company'
              ? 'max-w-3xl text-[clamp(2.25rem,1.6rem+3.2vw,3.75rem)] leading-[1.05]'
              : isDocument
                ? 'max-w-2xl text-[clamp(1.9rem,1.4rem+2.2vw,2.75rem)] leading-[1.1]'
                : 'max-w-2xl text-[clamp(2.1rem,1.5rem+2.9vw,3.25rem)] leading-[1.08]'
          }`}
        >
          {hero.h1}
        </h1>

        <p
          class={`animate-fade-in-up mt-6 leading-relaxed text-ink-light [animation-delay:160ms] ${
            variant === 'company' ? 'max-w-2xl font-display text-xl sm:text-2xl' : 'max-w-xl text-lg'
          }`}
        >
          {hero.intro}
        </p>

        {(hero.primaryCta || hero.secondaryLink) && (
          <div class="animate-fade-in-up mt-10 flex flex-wrap items-center gap-4 [animation-delay:240ms]">
            {hero.primaryCta && (
              <a href={hero.primaryCta.href} class={ctaClass(hero.primaryCta.variant)}>
                {hero.primaryCta.label}
              </a>
            )}
            {hero.secondaryLink &&
              (hero.secondaryLink.href === 'modal:elite' ? (
                <EliteModalButton
                  client:load
                  label={hero.secondaryLink.label}
                  location={`${route.pageName} hero`}
                />
              ) : (
                <a
                  href={hero.secondaryLink.href}
                  class="text-sm font-medium text-ink underline-offset-4 transition-colors hover:text-ink-light hover:underline"
                >
                  {hero.secondaryLink.label}
                </a>
              ))}
          </div>
        )}
      </div>

      {variant === 'feature' && (
        <div class="hidden lg:col-span-5 lg:block" aria-hidden="true">
          {/* Abstract DM texture: a live-feeling thread, no invented copy. */}
          <div class="animate-fade-in-up rounded-3xl border border-line bg-white p-6 shadow-none [animation-delay:320ms]">
            <div class="flex items-center gap-2 border-b border-line pb-4">
              <span class="relative flex h-2 w-2">
                <span class="absolute h-full w-full animate-ping rounded-full bg-fern/50"></span>
                <span class="relative h-2 w-2 rounded-full bg-fern"></span>
              </span>
              <span class="font-mono text-xs text-ink-faint">yourshop · Mira is on</span>
            </div>
            <div class="mt-5 space-y-3">
              <div class="h-8 w-3/5 rounded-2xl rounded-bl-md border border-line bg-paper"></div>
              <div class="h-8 w-2/5 rounded-2xl rounded-bl-md border border-line bg-paper"></div>
              <div class="ml-auto h-12 w-4/5 rounded-2xl rounded-br-md bg-fern/90"></div>
              <div class="flex justify-end pt-1">
                <span class="font-mono text-[0.65rem] text-ink-faint">replied in 4s</span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
