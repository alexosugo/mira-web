---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
---

<BaseLayout title="Page not found | Sellogram" description="The page you requested could not be found." canonicalPath="/404" noindex>
  <div class="flex min-h-screen flex-col bg-paper">
    <Header client:load />
    <main id="main-content" tabindex="-1" class="flex flex-1 items-center">
      <div class="mx-auto w-full max-w-[1280px] px-5 pb-24 pt-36 sm:px-8 sm:pt-40 lg:px-10">
        <p class="inline-flex -rotate-2 rounded-2xl bg-fern px-4 py-1 font-mono text-2xl text-ink sm:text-3xl">404</p>
        <h1 class="mt-8 max-w-3xl font-display text-[clamp(2.75rem,1.4rem+5.4vw,6rem)] font-semibold leading-[0.95] tracking-tighter text-ink [text-wrap:balance]">We couldn't find that page.</h1>
        <p class="mt-7 max-w-xl text-lg text-ink-light sm:text-xl">The page may have moved or the link may be incorrect.</p>
        <a href="/" class="mt-10 inline-flex min-h-12 items-center rounded-full bg-fern px-8 text-base font-semibold text-ink transition duration-300 hover:-translate-y-0.5 hover:bg-fern-deep hover:text-paper active:translate-y-0 active:scale-[0.98] motion-reduce:hover:translate-y-0">Back to home</a>
      </div>
    </main>
    <Footer client:visible />
  </div>
</BaseLayout>
